# Copie para .env (ou exporte no terminal). Tudo é opcional: sem nada, o RAG
# usa embeddings locais grátis e mostra o prompt em vez de chamar um modelo.

# Embeddings: local | openai | voyage | brinquedo
EMBEDDINGS_PROVEDOR=local
# EMBEDDINGS_MODELO=

# Geração: nenhum | anthropic | openai
GERACAO_PROVEDOR=nenhum
# GERACAO_MODELO=

# Chaves (só a do provedor que você escolher)
# OPENAI_API_KEY=
# VOYAGE_API_KEY=
# ANTHROPIC_API_KEY=

# Outro serviço no formato da OpenAI, como o Ollama local:
# OPENAI_BASE_URL=http://localhost:11434/v1

# Postgres com pgvector (lição 07 e app TypeScript). Sem isto, o app usa indice.json.
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco
